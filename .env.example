# Copy to .env. Used by docker compose (variable substitution) and by apps run on the host.
GRIDLINE_ENV=development            # production => strict CORS/base-URL validation, fixtures/seed refused
POSTGRES_PASSWORD=gridline          # CHANGE in production
# GRIDLINE_DB_PORT=5433             # host port for Postgres if 5432 is taken

# --- API (apps/api) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://gridline:gridline@localhost:5432/gridline
# Absolute base URL of the API as calendar apps will reach it (used to build webcal:// links).
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# --- sync / scheduler ---
SYNC_INTERVAL_MINUTES=30
SOURCE_TIMEOUT_SECONDS=240
SYNC_MIN_RATIO=0.5                  # a run returning < 50% of the previous count is a failure; data kept
# --- source health thresholds ---
SOURCE_HEALTHY_MAX_AGE_MINUTES=90   # newest live success older than this => stale
SOURCE_FAILING_AFTER_FAILURES=2     # consecutive failed live runs => failing
SOURCE_RUN_RETENTION_DAYS=30
LOG_LEVEL=INFO
# ICS feeds include sessions that started up to this many days ago.
FEED_LOOKBACK_DAYS=14
FEED_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY_HEADERS=false           # true only behind a proxy you control

# --- Web (apps/web) ---
# Server-side URL of the API (Next.js proxies browser calls via /api-proxy/*). On Vercel this is injected by the
# web -> api service binding in vercel.json: do not set it there. There, PUBLIC_API_BASE_URL must be https://<domain>/api.
API_URL=http://localhost:8000

# --- Tests ---
TEST_DATABASE_URL=postgresql+psycopg://gridline:gridline@localhost:5432/gridline_test

# --- production (Vercel + Neon): see docs/DEPLOYMENT.md. Placeholders only: never commit real values. ---
# Vercel `api` service:
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/gridline?sslmode=require   (POOLED)
#   ENVIRONMENT=production
#   PUBLIC_API_BASE_URL=https://<production-domain>/api
#   CORS_ORIGINS=https://<production-domain>
#   TRUST_PROXY_HEADERS=true
# GitHub Actions production-sync: secret NEON_DIRECT_DATABASE_URL (DIRECT host, no -pooler), variables
#   PUBLIC_API_BASE_URL and CORS_ORIGINS as above. The `web` service gets API_URL from the Vercel service binding:
#   do not set it there (and keep API_URL out of a root .env when running `vercel dev`: it would override the binding).
